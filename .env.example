# HeatShift requires no environment variables or secret keys.
# Optional for scripts/smoke.sh:
HEATSHIFT_SMOKE_PORT=4173

# Optional FastAPI team-sharing service
HEATSHIFT_DB_PATH=./server/heatshift.sqlite3
HEATSHIFT_CORS_ORIGINS=http://localhost:8080
HEATSHIFT_RATE_LIMIT=60
# Share tokens expire after 30 days by default; allowed range is 5 minutes to 365 days.
HEATSHIFT_SHARE_TTL_SECONDS=2592000
